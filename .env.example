# Twilio SMS Integration Environment Variables
# Copy this to .env and fill in your values

# Twilio API Credentials (required)
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Session Backend (optional)
# Leave blank to auto-detect: memory → redis → firestore
# SESSION_BACKEND=memory|redis|firestore

# Redis Configuration (for production session storage)
# Required if SESSION_BACKEND=redis or if REDIS_URL is set
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://:password@host:port/db

# Google Cloud Configuration (for Firestore session storage)
# Required if SESSION_BACKEND=firestore or if GOOGLE_CLOUD_PROJECT is set
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Server Configuration
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Logging
LOG_LEVEL=INFO
